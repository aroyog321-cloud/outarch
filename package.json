{
  "name": "termctl-tui",
  "version": "2.19.0",
  "type": "module",
  "description": "OUTARCH — a local-first developer command center with a shared PTY engine, TUI, and desktop client.",
  "bin": {
    "termctl": "./bin/termctl.js",
    "outarch": "./bin/termctl.js"
  },
  "main": "src/engine/index.cjs",
  "files": [
    "bin",
    "src",
    "integrations/vscode",
    "dist/groundstation/renderer",
    "OPEN_OUTARCH_WINDOWS.cmd",
    "VERIFY_OUTARCH_WINDOWS.cmd",
    "OPEN_MISSION_CONTROL_WINDOWS.cmd",
    "VERIFY_MISSION_CONTROL_WINDOWS.cmd",
    "scripts/ensure-renderer-build.cjs",
    "scripts/windows-release-check.cjs",
    "README-FIRST-WINDOWS.txt",
    "README.md",
    "RELEASE_NOTES.md",
    "mobile/android",
    "vite.groundstation.config.mjs",
    "termctl.config.example.json",
    "THIRD_PARTY_LICENSES.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "start": "node bin/termctl.js",
    "groundstation:build": "vite build --config vite.groundstation.config.mjs",
    "groundstation:capture": "npm run groundstation:build && node scripts/visual/capture-groundstation-matrix.cjs",
    "groundstation": "node scripts/ensure-renderer-build.cjs && electron src/groundstation/main/index.cjs",
    "groundstation:windows": "npm run groundstation",
    "verify:windows": "node scripts/windows-release-check.cjs",
    "package:store": "node scripts/msix/build-msix.mjs --mode store",
    "package:msix:test": "node scripts/msix/build-msix.mjs --mode test",
    "package:msix:install-test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/msix/install-test.ps1",
    "package:msix:verify": "node scripts/msix/verify-msix.mjs",
    "brand:store-assets": "python scripts/brand/build-store-assets.py",
    "test": "node --test --test-concurrency=1 test/*.test.cjs",
    "test:parallel": "node --test test/*.test.cjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "cmdk": "^1.1.1",
    "ink": "^4.4.1",
    "ink-text-input": "^5.0.1",
    "node-pty": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "electron": "40.10.6",
    "supabase": "^2.117.0",
    "vite": "6.4.3"
  }
}
