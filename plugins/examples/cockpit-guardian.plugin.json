{
  "manifestVersion": 1,
  "id": "dev.mission-control.cockpit-guardian",
  "name": "Cockpit Guardian",
  "version": "1.0.0",
  "publisher": "OUTARCH Intelligence",
  "description": "Continuous telemetry guardian monitoring worker stability, recipe runs, and human attention with automated recovery approvals.",
  "permissions": ["context.read", "health.read", "events.read", "attention.read", "worker.lifecycle.request", "recipe.run.request", "automation.run.request"],
  "surfaces": ["cockpit.banner", "health.status", "settings.summary", "needs.request"],
  "contributions": [
    {
      "id": "guardian-cockpit-banner",
      "surface": "cockpit.banner",
      "title": "System Guardian",
      "value": "Nominal",
      "detail": "All workers and recipes operating within normal telemetry thresholds.",
      "tone": "healthy",
      "rules": [
        {
          "any": [
            { "metric": "workers.critical.count", "operator": "gt", "operand": 0 },
            { "metric": "overall.status", "operator": "eq", "operand": "critical" }
          ],
          "title": "System Guardian Alert",
          "value": "Critical Outage",
          "detail": "Alert: {workers.failed.names} is down. Human attention required: {attention.first.title}",
          "tone": "critical",
          "actionId": "emergency-restart",
          "actionLabel": "Request emergency restart",
          "target": "{workers.failed.first.id}"
        },
        {
          "metric": "workers.failed.count",
          "operator": "gt",
          "operand": 0,
          "value": "{count} Worker(s) Failing",
          "detail": "Degraded workers: {workers.failed.names}",
          "tone": "warning",
          "actionId": "restart-failed-worker",
          "actionLabel": "Restart failing worker",
          "target": "{workers.failed.first.id}"
        }
      ]
    },
    {
      "id": "guardian-summary",
      "surface": "settings.summary",
      "title": "Cockpit Guardian",
      "value": "Active",
      "detail": "Monitoring project '{project.name}' with composite multi-metric rules.",
      "tone": "healthy"
    }
  ],
  "actions": [
    { "id": "emergency-restart", "label": "Emergency Restart Worker", "type": "worker", "operations": ["restart", "start"] },
    { "id": "restart-failed-worker", "label": "Restart Degraded Worker", "type": "worker", "operations": ["restart"] },
    { "id": "diagnose-automation", "label": "Trigger Diagnostics Automation", "type": "automation", "operations": ["test", "run"] }
  ]
}
